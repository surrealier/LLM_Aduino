# Environment Variables for ccoli
# Copy this file to .env and fill in your values

# OpenWeatherMap API Key (free tier: https://openweathermap.org/api)
WEATHER_API_KEY=your_api_key_here

# LLM provider API keys (set according to selected provider)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Server Port (optional, overrides config.yaml)
# SERVER_PORT=5001

# Wired USB serial overrides (optional)
# SERIAL_PORT=auto
# SERIAL_BAUDRATE=115200

# STT overrides (optional, override config.yaml)
# STT_DEVICE=cuda
# STT_LANGUAGE=ko
# STT_MODEL_SIZE=medium

# Backward-compatible STT device alias
# DEVICE=cuda

# TTS voice override (optional)
# TTS_VOICE=ko-KR-SunHiNeural

# Personal/local memory overrides (optional)
# MEMORY_DIR=../.codex/personal_memory
# MEMORY_REFRESH_INTERVAL=5

# Assistant Name (optional)
# ASSISTANT_NAME=ccoli

# Log Level (optional)
# LOG_LEVEL=INFO